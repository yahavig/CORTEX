{
  "name": "cortex",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CORTEX: Content Operations, Reels, Tracking & EXpenses",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "node --watch src/server/index.ts",
    "dev:web": "vite",
    "build": "vite build && node scripts/icloud-ignore.mjs",
    "start": "NODE_ENV=production node src/server/index.ts",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "service:install": "bash scripts/install-service.sh",
    "service:uninstall": "bash scripts/uninstall-service.sh",
    "postinstall": "node scripts/icloud-ignore.mjs",
    "app:install": "bash scripts/make-app.sh"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.17",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
